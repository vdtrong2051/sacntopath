/* ScanToPath 07.9 recovery: TECHNICAL LIGHT / cobalt interaction system.
   Design references: Spyder / Qt Creator pane navigation, Qt ADS docking rules.
   Surface/ink/accent: #FFFFFF / #17263C / #1463D7. No gray-on-gray wash.
   No SDK/SQLite/VTK dependency. No bitmap icons and no font pixels. */
QWidget {
    color: #17263C;
    font-family: "Segoe UI", "Noto Sans", "Arial";
    font-size: 10pt;
}
QMainWindow#ScanToPathMainWindow,
QWidget#desktopRoot, QStackedWidget#workspaceStack,
QWidget#workspaceScrollContent, QScrollArea,
QWidget#workspace_projects, QWidget#workspace_capture,
QWidget#workspace_inspect3d, QWidget#workspace_processing {
    background-color: #F4F8FD;
}
QMenuBar {
    background-color: #FFFFFF;
    color: #273B55;
    border-bottom: 1px solid #DCE6F2;
    padding: 2px;
}
QMenuBar::item { padding: 5px 12px; border-radius: 5px; }
QMenuBar::item:selected { color: #0E56B5; background-color: #EAF2FF; }
QMenu { background-color: #FFFFFF; color: #17263C; border: 1px solid #CFDBE9; padding: 5px; }
QMenu::item { padding: 7px 22px; border-radius: 5px; }
QMenu::item:selected { background-color: #EAF2FF; color: #0B55B8; }
QMenu::item:disabled { color: #7C8DA4; }
/* Navigation above the dock layout instead of a fifth vertical content column. */
QToolBar#workspaceToolbar {
    background-color: #FFFFFF;
    border: 0px;
    border-bottom: 1px solid #D6E3F2;
    spacing: 2px;
    padding: 3px 6px;
}
QToolBar#workspaceToolbar::separator { background-color: #D4DFED; width: 1px; margin: 5px 8px; }
QLabel#toolbarBrand { color: #10396F; font-size: 11pt; font-weight: 700; padding-left: 2px; }
QFrame#toolbarDivider { background-color: #D6E0ED; border: 0; margin-left: 4px; margin-right: 5px; }
QLabel#toolbarContext { color: #5A6E86; font-size: 9pt; padding: 0px 12px; }
QToolBar#workspaceToolbar QPushButton {
    background-color: transparent;
    color: #425571;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 6px;
    min-height: 22px;
    font-weight: 500;
}
QToolBar#workspaceToolbar QPushButton:hover {
    background-color: #EAF2FF;
    color: #1252A5;
}
QToolBar#workspaceToolbar QPushButton:checked {
    background-color: #E7F0FF;
    color: #0B55B8;
    border: 1px solid #C8DDFB;
    font-weight: 700;
}
QToolBar#workspaceToolbar QPushButton:focus { border: 1px solid #1463D7; }
/* Two intentional elevations: white panels and warm-white content canvas. */
/* All three native docks share a restrained 1px outline, including title bars.
   Do not introduce a nested boxed layout or heavy colored backgrounds. */
QDockWidget#explorerDock, QDockWidget#inspectorDock, QDockWidget#taskDock {
    background-color: #FFFFFF;
    color: #17263C;
    border: 1px solid #C7D6E7;
    border-radius: 9px;
}
QDockWidget::title {
    background-color: #FFFFFF;
    color: #263D59;
    border: 0px;
    border-bottom: 1px solid #D7E3F0;
    padding: 10px 13px;
    text-align: left;
    font-weight: 600;
}
QDockWidget::close-button, QDockWidget::float-button {
    border: 0px;
    border-radius: 5px;
    background-color: transparent;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #E5EFFD; }
QWidget#projectExplorer, QWidget#propertyInspector, QWidget#taskAndEventPanel {
    background-color: #FFFFFF;
    border: 0px;   /* native dock owns the outer outline */
}
/* Central workspace is visually distinct without boxing every child widget. */
QWidget#desktopRoot {
    background-color: #F4F8FD;
    border: 1px solid #D5E1EF;
    border-radius: 9px;
}
QSplitter::handle { background-color: #D8E3F0; }
QPushButton, QComboBox, QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    color: #19314D;
    background-color: #FFFFFF;
    border: 1px solid #CBD9E9;
    border-radius: 7px;
    padding: 6px 10px;
    selection-background-color: #1463D7;
    selection-color: #FFFFFF;
}
QPushButton:hover, QComboBox:hover {
    background-color: #EFF6FF;
    color: #0B55B8;
    border-color: #7DAEEB;
}
QPushButton:pressed { background-color: #DDEBFF; }
QPushButton:focus, QComboBox:focus, QLineEdit:focus,
QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus { border: 1px solid #1463D7; }
QPushButton:disabled, QComboBox:disabled, QLineEdit:disabled {
    color: #8292A8;
    background-color: #F2F5F9;
    border: 1px solid #DFE6EF;
}
QComboBox::drop-down { border: 0px; width: 22px; }
QComboBox QAbstractItemView { background-color: #FFFFFF; color: #17263C; selection-background-color: #E4F0FF; }
QPushButton#openProjectStore, QPushButton#workspacePrimaryAction {
    color: #FFFFFF;
    background-color: #1463D7;
    border: 1px solid #1463D7;
    font-weight: 600;
}
QPushButton#openProjectStore:hover, QPushButton#workspacePrimaryAction:hover {
    color: #FFFFFF;
    background-color: #0C54B9;
    border-color: #0C54B9;
}
QPushButton#openProjectStore:disabled, QPushButton#workspacePrimaryAction:disabled {
    color: #8292A8; background-color: #F2F5F9; border-color: #DFE6EF;
}
QLabel#projectStoreLabel { color: #4A6582; font-size: 9pt; }
QLabel#explorerEmptyLabel, QLabel#inspectorEmptyLabel, QLabel#taskEmptyLabel,
QLabel#eventSourceNote, QLabel#inspectorSourceNote { color: #526984; font-size: 9pt; }
QTreeWidget, QListWidget, QTableWidget {
    color: #23364F;
    background-color: #FFFFFF;
    alternate-background-color: #F4F8FD;
    border: 1px solid #E2EAF4;
    border-radius: 7px;
    selection-background-color: #DDEBFF;
    selection-color: #0B4FA6;
    outline: 0px;
}
QTreeWidget::item, QListWidget::item { padding: 4px 6px; min-height: 23px; }
QTreeWidget::item:hover, QListWidget::item:hover { background-color: #EFF6FF; }
QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #DDEBFF;
    color: #0B4FA6;
}
QHeaderView::section {
    background-color: #F3F7FC;
    color: #425B77;
    border: 0;
    border-right: 1px solid #E1E9F3;
    border-bottom: 1px solid #DCE5F0;
    padding: 6px 9px;
    font-weight: 600;
}
QTabWidget::pane { border: 1px solid #C9D9EB; border-radius: 8px; background-color: #FFFFFF; }
QTabBar::tab {
    background-color: #F0F5FC;
    color: #536A85;
    border: 1px solid #E0E8F3;
    border-bottom: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 9px 14px;
    margin-right: 3px;
}
/* R2.2.1: task controls live in the single dock title region. */
QWidget#taskDockTitleBar { background-color: #FFFFFF; border-bottom: 1px solid #D7E3F0; }
QLabel#taskDockTitle { color: #263D59; font-weight: 600; padding: 0px 5px; }
QLabel#taskDockTitleSummary { color: #526984; font-size: 9pt; padding-left: 6px; }
QPushButton#taskPanelExpandToggle, QToolButton#taskDockFloatButton, QToolButton#taskDockCloseButton {
    min-height: 20px; min-width: 20px; max-height: 24px; max-width: 26px;
    border: 0px; border-radius: 4px; background-color: transparent;
    color: #375875; padding: 0px;
}
QPushButton#taskPanelExpandToggle:hover, QToolButton#taskDockFloatButton:hover,
QToolButton#taskDockCloseButton:hover { background-color: #EAF2FF; }
QLabel#taskOperatorEmpty { color: #60778F; font-size: 9pt; padding: 3px 0px; }
/* R2.2: only the Task Center tabs are compressed; other tabs retain 07.9 contracts. */
QTabWidget#taskEventTabs QTabBar::tab {
    padding: 4px 9px;
    margin-right: 2px;
}
QLabel#taskCompactSummary { color: #526984; font-size: 9pt; padding-left: 6px; }
QPushButton#taskPanelExpandToggle {
    min-height: 20px;
    padding: 2px 9px;
    border: 1px solid #D5E2F1;
    background-color: #F4F8FD;
    color: #20538E;
}
QTabBar::tab:hover { background-color: #E6F0FF; color: #0B55B8; }
QTabBar::tab:selected { background-color: #FFFFFF; color: #0B55B8; border-color: #C9DAEF; font-weight: 700; }
QLabel#workspaceEyebrow { color: #1463D7; font-size: 9pt; font-weight: 700; }
QLabel#workspaceHeading { color: #122B4A; font-size: 21pt; font-weight: 700; }
QLabel#workspaceSubtitle { color: #526A86; font-size: 10pt; }
QFrame#workspacePanel {
    background-color: #FFFFFF;
    border: 1px solid #C9D8EA;
    border-radius: 11px;
}
QLabel#workspaceState {
    background-color: #E4F7F2;
    color: #08796A;
    border: 1px solid #BDE9DD;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 8pt;
    font-weight: 700;
}
QLabel#workspacePlanned { color: #677B94; font-size: 9pt; }
QLabel#workspaceFeatureTitle { color: #183654; font-size: 15pt; font-weight: 700; }
QLabel#workspaceDescription { color: #405A78; font-size: 10pt; padding-top: 2px; }
QLabel#workspaceFootnote { color: #60778F; font-size: 9pt; padding-top: 6px; }
QLabel#workspaceActionHint { color: #6E8197; font-size: 9pt; }
QStatusBar { color: #405A78; background-color: #FFFFFF; border-top: 1px solid #DCE6F2; }
QStatusBar QLabel { color: #405A78; font-size: 9pt; }
QScrollBar:vertical { background-color: #F0F5FA; width: 10px; margin: 0px; }
QScrollBar::handle:vertical { background-color: #A7B9CC; border-radius: 5px; min-height: 26px; }
QScrollBar::handle:vertical:hover { background-color: #829AB6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background-color: transparent; }
QScrollBar:horizontal { background-color: #F0F5FA; height: 10px; margin: 0px; }
QScrollBar::handle:horizontal { background-color: #A7B9CC; border-radius: 5px; min-width: 26px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background-color: transparent; }
QToolTip { color: #FFFFFF; background-color: #214368; border: 1px solid #3A6B9E; padding: 5px; }
QDialog { background-color: #F4F8FD; }
QDialogButtonBox QPushButton { min-width: 72px; }

/* Action zones: let the owning QLayouts determine width; never force a
   single-line button wider than a small laptop dock. */
QPushButton#startFixtureTask, QPushButton#cancelSelectedTask,
QPushButton#verifySelectedCaptureRaw, QPushButton#editProjectMetadata,
QPushButton#closeScanSession { min-height: 29px; padding: 6px 9px; }
QLabel#taskEmptyLabel, QLabel#projectStoreLabel,
QLabel#explorerEmptyLabel, QLabel#inspectorSourceNote {
    padding-top: 3px;
    padding-bottom: 3px;
}

/* R2.2.3A: scoped IDE-style task drawer; other docks/workspaces unchanged. */
QWidget#taskDockTitleBar { background-color: #F4F8FD; border: 0; }
QLabel#taskDockTitle { color: #223B5A; font-size: 10pt; font-weight: 600; }
QLabel#taskDockTitleSummary { color: #60758E; font-size: 9pt; }
QWidget#taskDockTitleBar QToolButton,
QWidget#taskDockTitleBar QPushButton#taskPanelExpandToggle {
    background: transparent; border: 0; border-radius: 3px;
    padding: 0; margin: 0; min-width: 0; min-height: 0;
}
QWidget#taskDockTitleBar QToolButton:hover,
QWidget#taskDockTitleBar QPushButton#taskPanelExpandToggle:hover { background-color: #E3EAF5; }
QWidget#taskAndEventPanel QTabWidget::pane { border: 0; border-radius: 0; }
QWidget#taskAndEventPanel QTabBar::tab {
    border: 0; border-bottom: 2px solid transparent; border-radius: 0;
    background: transparent; margin-right: 3px; padding: 3px 11px;
    min-height: 22px;
}
QWidget#taskAndEventPanel QTabBar::tab:selected {
    background: transparent; color: #0B55B8; border-bottom: 2px solid #1463D7;
}
QWidget#taskAndEventPanel QTreeWidget#sqliteAuditTimeline {
    border: 0; border-radius: 0; background-color: #FFFFFF;
}
QWidget#taskAndEventPanel QTreeWidget::item,
QWidget#taskAndEventPanel QListWidget::item { padding: 2px 4px; min-height: 19px; }
QLabel#taskOperatorEmpty, QLabel#taskEventEmpty {
    color: #60758E; font-size: 9pt; padding: 5px 8px;
}

/* R2.2.3A-FINAL: IDE chrome + visible gutters and crisp task panes. */
QWidget#taskDockTitleBar {
    background-color: #FFFFFF;
    border: 0;
    border-bottom: 1px solid #B8CAE0;
}
QLabel#taskDockTitle { color: #193653; font-weight: 600; }
QLabel#taskDockTitleSummary { color: #61738A; }
QWidget#taskDockTitleBar QToolButton,
QWidget#taskDockTitleBar QPushButton#taskPanelExpandToggle {
    border: 1px solid transparent;
    background-color: transparent;
    border-radius: 4px;
    padding: 0;
}
QWidget#taskDockTitleBar QToolButton:hover,
QWidget#taskDockTitleBar QPushButton#taskPanelExpandToggle:hover {
    border-color: #C9D9EA;
    background-color: #E7EFF8;
}
QWidget#taskAndEventPanel QTabWidget#taskEventTabs { background-color: #F4F8FD; }
QWidget#taskAndEventPanel QTabWidget#taskEventTabs::pane {
    background-color: #FFFFFF;
    border: 0;
    border-top: 1px solid #C9D9EA;
    border-radius: 0;
}
QWidget#taskAndEventPanel QTabBar::tab {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px 10px;
    margin: 3px 2px 3px 4px;
    min-height: 18px;
}
QWidget#taskAndEventPanel QTabBar::tab:selected {
    background-color: #E7F0FF;
    color: #0B55B8;
    border: 1px solid #C8DDFB;
    font-weight: 600;
}
QWidget#taskAndEventPanel QTreeWidget#sqliteAuditTimeline {
    background-color: #FFFFFF;
    border: 1px solid #D5E1EF;
    border-radius: 0;
}
QWidget#taskAndEventPanel QListWidget#uiEventList {
    background-color: #FFFFFF;
    border: 1px solid #D5E1EF;
    border-radius: 0;
}
QLabel#taskOperatorEmpty, QLabel#taskEventEmpty {
    background: #FFFFFF;
    color: #60758E;
    border: 0;
    padding: 6px 10px;
}

/* R2.2.3C: distinct task title, tab strip, and content surfaces. */
QWidget#taskDockTitleBar {
    background-color: #EBF2FA;
    border: 0;
    border-bottom: 1px solid #AFC3DB;
}
QLabel#taskDockTitle {
    color: #17395F;
    font-weight: 600;
}
QLabel#taskDockTitleSummary {
    color: #5D718A;
    padding-left: 5px;
}
QWidget#taskAndEventPanel QTabWidget#taskEventTabs {
    background-color: #F7FAFE;
}
QWidget#taskAndEventPanel QTabBar {
    background-color: #F7FAFE;
    border: 0; /* separator is now a real layout widget, not an overpaint */
}
QWidget#taskAndEventPanel QTabBar::tab {
    background-color: transparent;
    color: #425B77;
    border: 1px solid transparent;
    border-radius: 5px;
    min-height: 19px;
    padding: 2px 11px;
    margin: 3px 2px 3px 4px;
}
QWidget#taskAndEventPanel QTabBar::tab:hover {
    background-color: #EDF4FF;
    color: #0B55B8;
}
QWidget#taskAndEventPanel QTabBar::tab:selected {
    background-color: #E7F0FF;
    border: 1px solid #C8DDFB;
    color: #0B55B8;
    font-weight: 600;
}
QWidget#taskAndEventPanel QTabWidget#taskEventTabs::pane {
    background-color: #FFFFFF;
    border: 0;
    border-top: 1px solid #B9CCDF;
    border-radius: 0;
}

/* R2.2.3C layout separator is 1 real pixel, outside text paint areas. */
QFrame#taskDockHeaderSeparator { background-color: #AFC3DB; border: 0; }

/* R3.1: explicit Store context with real visual boundaries; Project scope only. */
QFrame#recentStorePanel {
    background-color: #FFFFFF;
    border: 1px solid #C9D8E8;
    border-radius: 8px;
}
QLabel#recentStoreHeading, QLabel#recentStoreListHeading {
    color: #163D70;
    font-size: 9pt;
    font-weight: 700;
}
QFrame#recentStoreTopSeparator, QFrame#recentStoreListSeparator {
    background-color: #CAD9E9;
    border: 0;
}
QLabel#recentStoreName {
    color: #15365B;
    font-weight: 700;
    font-size: 12pt;
}
QLabel#recentStorePath {
    color: #516982;
    font-size: 9pt;
}
QLabel#recentStoreState, QLabel#recentStoreEmpty {
    color: #5D7590;
    font-size: 9pt;
}
QListWidget#recentStoreList {
    border: 1px solid #D7E3F0;
    border-radius: 5px;
    background-color: #FFFFFF;
}
QListWidget#recentStoreList::item {
    min-height: 24px;
    padding: 3px 8px;
}
QPushButton#recentStoreBrowse { font-weight: 600; }
QPushButton#recentStoreOpenSelected { color: #0B55B8; }
