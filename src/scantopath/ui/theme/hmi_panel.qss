/* ScanToPath — HMI công nghiệp tối giản / VS Code density.
   Bảng màu: graphite neutral, steel-blue focus, muted amber caution.
   Bo góc 3–6 px; không gradients, không animation, không dependency mới. */
QWidget {
    color: #D9DEE5;
    font-family: "Segoe UI", "Arial";
    font-size: 12px;
}
QMainWindow#ScanToPathMainWindow, QWidget#desktopRoot,
QFrame#workspaceArea, QStackedWidget#workspaceStack,
QWidget#workspaceScrollContent, QScrollArea {
    background-color: #1E2126;
}
QFrame#navigationSidebar {
    background-color: #252930;
    border-right: 1px solid #3A414B;
}
QLabel#appBrand { font-size: 17px; font-weight: 700; color: #EFF2F6; }
QLabel#appBrandCaption { font-size: 10px; color: #9CA7B4; }
QLabel#navTitle { font-size: 10px; font-weight: 700; color: #AEB8C3; }
QLabel#stageLabel { color: #BFC9D3; font-size: 10px; font-weight: 700; }
QLabel#sidebarNote { color: #9EA9B6; font-size: 10px; }
QPushButton[checkable="true"] {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    color: #CAD2DC;
    text-align: left;
}
QPushButton[checkable="true"]:hover { background-color: #343B45; }
QPushButton[checkable="true"]:checked {
    background-color: #354A5D;
    border-left: 2px solid #7196B7;
    color: #F2F6FA;
    font-weight: 600;
}
QPushButton:focus { border: 1px solid #7897B3; }
QPushButton:disabled { color: #78828F; background-color: #2B3038; }
QPushButton#startFixtureTask, QPushButton#cancelSelectedTask {
    background-color: #323A44;
    border: 1px solid #566270;
    border-radius: 4px;
    padding: 5px 9px;
    min-height: 22px;
}
QPushButton#startFixtureTask:hover, QPushButton#cancelSelectedTask:hover {
    background-color: #3B4652;
    border-color: #7790A6;
}
QPushButton#startFixtureTask:disabled, QPushButton#cancelSelectedTask:disabled {
    color: #87929E;
    background-color: #2B3036;
    border-color: #424B55;
}
QFrame#workspaceTopbar {
    background-color: #252A31;
    border-bottom: 1px solid #3B444F;
}
QLabel#workspaceTopbarTitle, QLabel#baselineMarker {
    color: #AFBAC6;
    font-size: 10px;
    font-weight: 600;
}
QLabel#baselineMarker {
    background-color: #303943;
    border: 1px solid #48535F;
    border-radius: 3px;
    padding: 3px 7px;
}
QLabel#workspaceHeading { font-size: 23px; font-weight: 650; color: #EFF2F6; }
QLabel#workspaceSubtitle { font-size: 12px; color: #B3BEC9; }
QLabel#workspaceState {
    color: #D9B77C;
    background-color: #3D362C;
    border: 1px solid #675640;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
}
QLabel#workspacePlanned { color: #AAB5C2; font-size: 11px; }
QFrame#workspacePanel {
    background-color: #292F36;
    border: 1px solid #414A55;
    border-radius: 6px;
}
QLabel#workspaceKicker { color: #9FB9D1; font-size: 10px; font-weight: 650; }
QLabel#workspaceFeatureTitle { color: #E1E7EE; font-size: 17px; font-weight: 650; }
QLabel#workspaceDescription { color: #C3CDD8; font-size: 12px; }
QLabel#workspaceFootnote { color: #9FABBA; font-size: 10px; }
QMenuBar { background-color: #252930; color: #D9DEE5; padding: 2px; }
QMenuBar::item { padding: 3px 9px; }
QMenuBar::item:selected { background-color: #374350; }
QMenu { background-color: #252A31; color: #DFE6ED; border: 1px solid #515C69; }
QMenu::item { padding: 5px 22px; }
QMenu::item:selected { background-color: #3E5265; }
QMenu::item:disabled { color: #858F9D; }
QStatusBar { background-color: #252930; color: #B6C1CD;
    border-top: 1px solid #3B444F; }
QStatusBar QLabel { color: #B6C1CD; font-size: 11px; }
QDockWidget { color: #D9DEE5; background-color: #252A31; }
QDockWidget::title {
    background-color: #303740;
    border-bottom: 1px solid #4B5562;
    padding: 5px 8px;
    text-align: left;
}
QDockWidget::close-button, QDockWidget::float-button {
    border: 0px;
    background-color: transparent;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #475360;
}
QWidget#projectExplorer, QWidget#propertyInspector, QWidget#taskAndEventPanel {
    background-color: #252A31;
}
QLabel#explorerEmptyLabel, QLabel#inspectorEmptyLabel,
QLabel#taskEmptyLabel, QLabel#eventSourceNote, QLabel#inspectorSourceNote {
    color: #B9C4D1;
    font-size: 11px;
}
QTabWidget::pane { border: 1px solid #3D4753; background-color: #252A31; }
QTabBar::tab { background-color: #292F36; border: 1px solid #3F4955;
    color: #B8C4D0; padding: 5px 11px; }
QTabBar::tab:selected { background-color: #394757; color: #EFF2F6; }
QTreeWidget, QListWidget {
    background-color: #252A31;
    alternate-background-color: #2D333C;
    color: #D7DFE7;
    border: 1px solid #404B57;
    border-radius: 3px;
    selection-background-color: #3D5265;
    selection-color: #FFFFFF;
}
QTreeWidget::item, QListWidget::item { min-height: 20px; padding: 2px 4px; }
QTreeWidget::item:hover, QListWidget::item:hover { background-color: #343F4A; }
QHeaderView::section { background-color: #303740; color: #BFCAD6;
    border: 0px; border-right: 1px solid #454F5C;
    border-bottom: 1px solid #454F5C; padding: 5px 7px; }
QScrollBar:vertical { background-color: #242A31; width: 11px; margin: 0px; }
QScrollBar::handle:vertical { background-color: #596574; border-radius: 4px; min-height: 23px; }
QScrollBar::handle:vertical:hover { background-color: #6A7888; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background-color: transparent; }
QScrollBar:horizontal { background-color: #242A31; height: 11px; margin: 0px; }
QScrollBar::handle:horizontal { background-color: #596574; border-radius: 4px; min-width: 25px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background-color: transparent; }
