# ScanToPath - Git ignore

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python packaging
dist/
*.whl

# CMake / native build directories
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# Compiled native outputs
*.obj
*.o
*.lib
*.dll
*.exe
*.pyd
*.pdb
*.exp
*.ilk
*.idb
*.tlog

# Visual Studio / local IDE state
.vs/
*.suo
*.user
*.VC.db
*.VC.opendb

# Local capture data; never commit raw scans by default
scantopath-data/

# Developer-only SDK and temporary patch directories
_sdk/
_setup/

# Temporary data and credentials
*.log
*.tmp
*.bak
*.swp
.env
.env.*
!.env.example
*.pem

# OS
.DS_Store
Thumbs.db
/Log/
